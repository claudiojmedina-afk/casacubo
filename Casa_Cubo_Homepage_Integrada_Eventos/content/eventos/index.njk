---
title: Eventos | Casa Cubo
permalink: /eventos/
---
{% set eventos = collections.eventos | sortByDate %}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Eventos | Casa Cubo</title>
  <meta name="description" content="Talleres, experiencias y eventos de Casa Cubo.">
  <link rel="stylesheet" href="/css/evento.css">
</head>
<body class="listing-page">
  <header class="site-header">
    
<a class="brand brand-logo" href="/" aria-label="Casa Cubo, inicio">
  <img
    src="/assets/img/logo-cubo.png"
    alt="Casa Cubo"
    width="110"
    height="72"
  >
</a>

    <nav><a href="/eventos/">Eventos</a><a href="https://casacubo.empretienda.com.ar/">Tienda online</a></nav>
  </header>
  <main class="listing-wrap">
    <p class="eyebrow">CASA CUBO / AGENDA</p>
    <h1>Próximas experiencias.</h1>
    <p class="listing-intro">Talleres, encuentros y experiencias para crear, aprender y compartir.</p>
    <section class="event-grid" data-upcoming-list>
      {% for evento in eventos %}
        {% if evento.data.status == 'publicado' or evento.data.status == 'finalizado' %}
        <a class="event-card" href="{{ evento.url }}" data-event-start="{{ evento.data.sort_date }}" {% if evento.data.end_date %}data-event-end="{{ evento.data.end_date }}"{% endif %} data-event-status="{{ evento.data.status }}">
          <div class="event-card-image"><img src="{{ evento.data.image }}" alt="{{ evento.data.title }}"></div>
          <div class="event-card-copy"><span class="pill">{{ evento.data.category }}</span><h2>{{ evento.data.title }}</h2><p>{{ evento.data.excerpt }}</p><div class="event-card-meta">{{ evento.data.sort_date | date_es }} · {{ evento.data.time }}</div></div>
        </a>
        {% endif %}
      {% endfor %}
    </section>
    <p data-event-empty="[data-upcoming-list]" hidden>Por ahora no hay próximas experiencias. Volvé pronto.</p>
    <section class="archive-section" data-past-section hidden>
      <p class="eyebrow">ARCHIVO CASA CUBO</p>
      <h2>Experiencias que ya pasaron.</h2>
      <p>Así fueron los encuentros que compartimos en Casa Cubo.</p>
      <div class="event-grid" data-past-list></div>
    </section>
  </main>
<script src="/js/eventos-auto.js" defer></script>
</body>
</html>
