<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>Eventos | Casa Cubo</title>

  <meta
    name="description"
    content="Talleres, experiencias y eventos de Casa Cubo."
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/evento.css"
  >
</head>


<body class="listing-page">

<header class="site-header">

  <a
    class="brand brand-logo"
    href="/"
    aria-label="Casa Cubo, inicio"
  >
    <img
      src="https://ik.imagekit.io/fo8ajuwvyo/logocc.png"
      alt="Casa Cubo"
    >
  </a>


  <nav>

    <a href="/">
      Inicio
    </a>

    <a
      class="active"
      href="/eventos/"
    >
      Experiencias
    </a>

    <a href="/crear-nuevos-mundos/">
      Crear Nuevos Mundos
    </a>

    <a
      href="https://crearnuevosmundos.empretienda.com.ar/"
      target="_blank"
      rel="noopener"
    >
      Tienda online ↗
    </a>

  </nav>

</header>


<main class="listing-wrap">

  <!-- CABECERA -->

  <header class="listing-header">

    <p class="eyebrow">
      CASA CUBO / AGENDA
    </p>

    <h1>
      Próximas experiencias.
    </h1>

    <p class="listing-intro">
      Talleres, encuentros y experiencias para crear, aprender y compartir.
    </p>

  </header>



  <!-- PRÓXIMAS EXPERIENCIAS -->

  <section
    class="events-section"
    aria-labelledby="proximas-experiencias"
  >

    <div class="events-section-head">

      <div>

        <p class="eyebrow">
          LO QUE VIENE
        </p>

        <h2 id="proximas-experiencias">
          Próximas experiencias
        </h2>

      </div>


      <p>
        Ordenadas desde la fecha más cercana.
      </p>

    </div>


    <div
      id="upcoming-events"
      class="event-grid"
    ></div>


    <div
      id="upcoming-empty"
      class="events-empty"
      hidden
    >
      <p>
        No hay próximas experiencias publicadas por ahora.
      </p>
    </div>

  </section>



  <!-- EXPERIENCIAS ANTERIORES -->

  <section
    id="past-events-section"
    class="events-section events-section--past"
    aria-labelledby="experiencias-anteriores"
    hidden
  >

    <div class="events-section-head">

      <div>

        <p class="eyebrow">
          ARCHIVO
        </p>

        <h2 id="experiencias-anteriores">
          Experiencias que ya pasaron
        </h2>

      </div>


      <p>
        Encuentros anteriores de Casa Cubo.
      </p>

    </div>


    <div
      id="past-events"
      class="event-grid event-grid--past"
    ></div>

  </section>



  <!--
    FUENTE DE EVENTOS

    Eleventy imprime todos los eventos publicados acá.
    JavaScript decide en cada visita si son futuros o pasados.
  -->

  <div
    id="events-source"
    hidden
  >

    {% for evento in collections.eventos %}

      {% if evento.data.status == "publicado" or evento.data.status == "finalizado" %}

        <a
          class="event-card"
          href="{{ evento.url }}"
          data-event-date="{{ evento.data.sort_date }}"
          data-event-status="{{ evento.data.status }}"
        >

          <div class="event-card-image">

            <img
              src="{{ evento.data.image }}"
              alt="{{ evento.data.title }}"
              loading="lazy"
            >

          </div>


          <div class="event-card-copy">

            <span class="pill">
              {{ evento.data.category }}
            </span>


            <h2>
              {{ evento.data.title }}
            </h2>


            {% if evento.data.excerpt %}

              <p>
                {{ evento.data.excerpt }}
              </p>

            {% endif %}


            <div class="event-card-meta">

              {{ evento.data.sort_date | date_es }}

              {% if evento.data.time %}
                · {{ evento.data.time }}
              {% endif %}

            </div>

          </div>

        </a>

      {% endif %}

    {% endfor %}

  </div>

</main>



