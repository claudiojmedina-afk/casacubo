</a>



<script>

document.addEventListener("DOMContentLoaded", () => {

  const source =
    document.getElementById("events-source");

  const upcomingContainer =
    document.getElementById("upcoming-events");

  const pastContainer =
    document.getElementById("past-events");

  const pastSection =
    document.getElementById("past-events-section");

  const upcomingEmpty =
    document.getElementById("upcoming-empty");


  if (
    !source ||
    !upcomingContainer ||
    !pastContainer
  ) {
    return;
  }


  /*
    Fecha actual de Argentina.

    Usamos America/Argentina/Buenos_Aires para que
    el resultado no dependa del país o zona horaria
    del visitante.
  */

  const todayParts =
    new Intl.DateTimeFormat(
      "en-CA",
      {
        timeZone: "America/Argentina/Buenos_Aires",
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
      }
    )
    .formatToParts(new Date());


  const todayData = {};

  todayParts.forEach(part => {

    if (part.type !== "literal") {
      todayData[part.type] = part.value;
    }

  });


  const today =
    `${todayData.year}-${todayData.month}-${todayData.day}`;


  const upcoming = [];
  const past = [];


  const cards =
    Array.from(
      source.querySelectorAll(".event-card")
    );


  cards.forEach(card => {

    const rawDate =
      card.dataset.eventDate || "";

    const status =
      card.dataset.eventStatus || "";


    /*
      sort_date tiene este formato:

      2026-11-01T11:00:00

      Solo usamos:
      2026-11-01

      Por eso el evento sigue activo durante todo
      el día y pasa a finalizado después de las 00:00.
    */

    const eventDate =
      rawDate.substring(0, 10);


    const isPast =
      status === "finalizado" ||
      (eventDate && eventDate < today);


    if (isPast) {

      card.classList.add(
        "event-card--past"
      );


      const image =
        card.querySelector(
          ".event-card-image"
        );


      if (image) {

        const finished =
          document.createElement("span");

        finished.className =
          "event-finished";

        finished.textContent =
          "Finalizado";

        image.appendChild(finished);

      }


      const copy =
        card.querySelector(
          ".event-card-copy"
        );


      if (copy) {

        const state =
          document.createElement("div");

        state.className =
          "event-card-state";

        state.textContent =
          "Evento finalizado";

        copy.appendChild(state);

      }


      past.push({
        card,
        date:eventDate
      });

    } else {

      upcoming.push({
        card,
        date:eventDate
      });

    }

  });



  /*
    PRÓXIMOS:
    fecha más cercana primero.
  */

  upcoming.sort(
    (a,b) =>
      a.date.localeCompare(b.date)
  );



  /*
    PASADOS:
    evento más reciente primero.
  */

  past.sort(
    (a,b) =>
      b.date.localeCompare(a.date)
  );



  upcoming.forEach(item => {

    upcomingContainer.appendChild(
      item.card
    );

  });



  past.forEach(item => {

    pastContainer.appendChild(
      item.card
    );

  });



  /*
    Estados vacíos
  */

  if (upcoming.length === 0) {

    upcomingEmpty.hidden = false;

  } else {

    upcomingEmpty.hidden = true;

  }



  if (past.length > 0) {

    pastSection.hidden = false;

  } else {

    pastSection.hidden = true;

  }

});

</script>


</body>
</html>
