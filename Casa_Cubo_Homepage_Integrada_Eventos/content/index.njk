<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Casa Cubo — Arte, diseño, talleres y comunidad.">
  <title>Casa Cubo — Arte, diseño, talleres y comunidad</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<header class="site-header">
  <a class="brand" href="/" aria-label="Casa Cubo, inicio">
    <span class="brand-mark" aria-hidden="true">◇</span>
    <span>CASA<br>CUBO</span>
  </a>

  <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menú</button>

  <nav id="main-nav" class="main-nav">
    <a class="active" href="#inicio">Inicio</a>
    <a href="#talleres">Talleres</a>
    <a href="#eventos">Eventos</a>
    <a href="#galeria">Galería</a>
    <a href="#nosotros">Nosotros</a>
    <a href="#contacto">Contacto</a>
  </nav>

  <div class="header-actions">
    <a href="#" aria-label="Instagram">◎</a>
    <a href="#" aria-label="Facebook">●</a>
    <a class="store-link" href="https://crearnuevosmundos.empretienda.com.ar/" target="_blank" rel="noopener">
      Tienda online ↗
    </a>
    <small>en Empretienda.com</small>
  </div>
</header>

<main>
  <section id="inicio" class="hero section-shell">
    <div class="hero-copy">
      <span class="eyebrow">CASA CUBO</span>
      <h1>Arte,<br> diseño,<br> talleres y<br> comunidad.</h1>
      <p>Un espacio para crear, aprender, compartir y disfrutar. Talleres, eventos, exposiciones y mucho más.</p>
      <a class="button button-pink" href="#nosotros">Conocé más <span>→</span></a>
    </div>

    {% if home.hero_carousel and home.hero_carousel.length %}
    <div class="hero-photo photo-frame hero-carousel" data-hero-carousel aria-label="Carrusel principal">
      <div class="hero-carousel-track">
        {% for slide in home.hero_carousel %}
          {% if slide.image %}
            {% if slide.link %}
              <a
                class="hero-slide{% if loop.first %} is-active{% endif %}"
                href="{{ slide.link }}"
                {% if slide.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-hidden="{% if loop.first %}false{% else %}true{% endif %}"
                tabindex="{% if loop.first %}0{% else %}-1{% endif %}"
              >
                <img
                  src="{{ slide.image }}"
                  alt="{{ slide.alt or 'Casa Cubo' }}"
                  {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                >
              </a>
            {% else %}
              <div
                class="hero-slide{% if loop.first %} is-active{% endif %}"
                aria-hidden="{% if loop.first %}false{% else %}true{% endif %}"
              >
                <img
                  src="{{ slide.image }}"
                  alt="{{ slide.alt or 'Casa Cubo' }}"
                  {% if not loop.first %}loading="lazy"{% endif %}
                >
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

      {% if home.hero_carousel.length > 1 %}
        <button class="hero-carousel-arrow hero-carousel-prev" type="button" aria-label="Imagen anterior">‹</button>
        <button class="hero-carousel-arrow hero-carousel-next" type="button" aria-label="Imagen siguiente">›</button>

        <div class="hero-carousel-dots" aria-label="Seleccionar imagen">
          {% for slide in home.hero_carousel %}
            <button
              class="hero-carousel-dot{% if loop.first %} is-active{% endif %}"
              type="button"
              data-slide-index="{{ loop.index0 }}"
              aria-label="Ver imagen {{ loop.index }}"
              aria-current="{% if loop.first %}true{% else %}false{% endif %}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    {% else %}
    <div class="hero-photo photo-frame">
      <img src="/assets/img/hero.jpg" alt="Mesa de trabajo de Casa Cubo">
    </div>
    {% endif %}

    <div class="hero-note">Crear<br>también es<br>una forma<br>de vivir
      <span class="scribble">⌁</span>
    </div>

    <div class="hero-index"><strong>01</strong><span>02</span><span>03</span></div>
    <div class="cube-watermark" aria-hidden="true">◇</div>
  </section>

  
<section class="categories section-shell">

  <!-- 1. CREAR NUEVOS MUNDOS -->
  <a class="category cat-pink" href="/crear-nuevos-mundos/">
    <div class="cat-icon">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <rect x="9" y="11" width="30" height="25" rx="2"/>
        <path d="M14 17h20"/>
        <path d="M14 23h12"/>
        <path d="M14 29h8"/>
        <path d="M30 29l3 3 6-7"/>
      </svg>
    </div>
    <strong>Crear Nuevos Mundos</strong>
    <small>Talleres regulares<br>Artes visuales</small>
    <b>→</b>
  </a>

  <!-- 2. HACERES -->
  <a class="category cat-yellow" href="/crear-nuevos-mundos/">
    <div class="cat-icon">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="M13 35l9-9"/>
        <path d="M26 22l9-9"/>
        <path d="M31 10l7 7"/>
        <path d="M10 38l6-1 20-20-5-5-20 20-1 6z"/>
        <path d="M12 12l8 8"/>
        <path d="M9 9l5 1-4 4-1-5z"/>
      </svg>
    </div>
    <strong>Haceres</strong>
    <small>Oficios<br>Workshops</small>
    <b>→</b>
  </a>

  <!-- 3. EVENTOS -->
  <a class="category cat-lavender" href="/eventos/">
    <div class="cat-icon">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="M12 25h24v13H12z"/>
        <path d="M10 25h28"/>
        <path d="M16 25v-6h16v6"/>
        <path d="M18 19v-4"/>
        <path d="M24 19v-5"/>
        <path d="M30 19v-4"/>
        <path d="M18 12c1-2 2-3 2-5 2 2 3 3 2 5-1 2-3 2-4 0z"/>
        <path d="M24 11c1-2 2-3 2-5 2 2 3 3 2 5-1 2-3 2-4 0z"/>
        <path d="M30 12c1-2 2-3 2-5 2 2 3 3 2 5-1 2-3 2-4 0z"/>
      </svg>
    </div>
    <strong>Eventos</strong>
    <small>Cumpleaños y celebraciones</small>
    <b>→</b>
  </a>

  <!-- 4. EXPERIENCIAS -->
  <a class="category cat-sky" href="/eventos/">
    <div class="cat-icon">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <rect x="9" y="12" width="30" height="27" rx="2"/>
        <path d="M15 8v8"/>
        <path d="M33 8v8"/>
        <path d="M9 20h30"/>
        <path d="M15 26h5"/>
        <path d="M24 26h5"/>
        <path d="M33 26h1"/>
        <path d="M15 32h5"/>
        <path d="M24 32h5"/>
        <path d="M33 32h1"/>
      </svg>
    </div>
    <strong>Experiencias</strong>
    <small>Pintura, cerámica, tarot y más</small>
    <b>→</b>
  </a>

  <!-- 5. ARTE -->
  <a class="category cat-orange" href="/eventos/">
    <div class="cat-icon">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="M24 8c-9 0-16 6-16 14 0 8 7 15 15 15h3c2 0 3-1 3-3 0-2 1-3 3-3h3c3 0 5-2 5-5 0-10-7-18-16-18z"/>
        <circle cx="16" cy="20" r="1.5"/>
        <circle cx="22" cy="15" r="1.5"/>
        <circle cx="29" cy="16" r="1.5"/>
        <circle cx="34" cy="21" r="1.5"/>
      </svg>
    </div>
    <strong>Arte</strong>
    <small>Muestras y encuentros</small>
    <b>→</b>
  </a>

  <!-- 6. TIENDA -->
  <a
    class="category cat-tea"
    href="https://crearnuevosmundos.empretienda.com.ar/"
    target="_blank"
    rel="noopener"
  >
    <div class="cat-icon">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="M12 18h24l-2 21H14l-2-21z"/>
        <path d="M17 18c0-5 3-9 7-9s7 4 7 9"/>
        <path d="M18 25h12"/>
      </svg>
    </div>
    <strong>Cosas Para Hacer Cosas</strong>
    <small>Entrá a nuestra tienda, seguro<br>algo te llevás</small>
    <b>→</b>
  </a>

</section>


  <span id="eventos" class="anchor-target" aria-hidden="true"></span>
  <section id="talleres" class="workshops section-shell">
    <div class="section-intro">
      <span class="eyebrow">TALLERES Y EVENTOS</span>
      <h2>Aprendé,<br>creá, compartí</h2>
      <p>Descubrí nuestra propuesta de talleres, eventos y experiencias creativas. Desde técnicas tradicionales hasta propuestas contemporáneas, todo en un ambiente cálido y relajado.</p>
      <a class="button button-dark" href="/eventos/">Ver todos los talleres <span>→</span></a>
    </div>

    <div class="workshop-grid" data-home-events>
      {% set proximos = collections.eventos | sort(attribute='data.sort_date') %}
      {% for evento in proximos %}
        {% if evento.data.status == 'publicado' or evento.data.status == 'finalizado' %}
          <article class="workshop-card" data-event-start="{{ evento.data.sort_date }}" {% if evento.data.end_date %}data-event-end="{{ evento.data.end_date }}"{% endif %} data-event-status="{{ evento.data.status }}">
            <div class="card-image"><img src="{{ evento.data.image }}" alt="{{ evento.data.title }}"></div>
            <span class="pill pill-pink">{{ evento.data.category }}</span>
            <h3>{{ evento.data.title }}</h3>
            <p class="date">▣ {{ evento.data.sort_date | date_short }} · {{ evento.data.time }}</p>
            <p>{{ evento.data.excerpt }}</p>
            <a href="{{ evento.url }}">Ver más →</a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <p data-home-events-empty hidden>Estamos preparando nuevas experiencias.</p>
    <a class="button button-dark" href="/eventos/">Ver agenda y experiencias anteriores <span>→</span></a>
    <button class="slider-arrow" aria-label="Ver más eventos" onclick="window.location.href='/eventos/'">→</button>
  </section>

  <section id="nosotros" class="about section-shell">
    <div class="about-photo photo-frame">
      <img src="/assets/img/about.jpg" alt="Espacio creativo de Casa Cubo">
    </div>
    <div class="about-copy">
      <span class="eyebrow">SOBRE CASA CUBO</span>
      <h2>Más que una tienda,<br>una comunidad creativa</h2>
      <p>Casa Cubo es un espacio donde el arte, el diseño y la creatividad se encuentran. Organizamos talleres, eventos y experiencias para todas las edades, con materiales incluidos y acompañamiento.</p>
      <a class="button button-outline" href="#contacto">Conocé nuestra historia <span>→</span></a>
      <div class="about-doodle">◇<br><em>La creatividad<br>también se<br>comparte ♥</em></div>
    </div>
  </section>

  <section id="galeria" class="instagram section-shell">
    <div class="instagram-copy">
      <span class="eyebrow">SEGUINOS EN INSTAGRAM</span>
      <h2>@casacubo</h2>
      <p>Compartimos procesos, talleres, obras, ideas y mucho más.</p>
      <a class="button button-outline" href="#" target="_blank" rel="noopener">Seguinos&nbsp; ◎</a>
    </div>
    <div class="instagram-grid">
      <img src="/assets/img/insta-pinceles.jpg" alt="Pinceles y materiales">
      <img src="/assets/img/insta-taller.jpg" alt="Actividad en Casa Cubo">
      <img src="/assets/img/insta-taza.jpg" alt="Objeto de Casa Cubo">
      <img src="/assets/img/insta-galeria.jpg" alt="Galería y obras">
      <img src="/assets/img/insta-plantas.jpg" alt="Espacio creativo">
    </div>
  </section>

  <section id="contacto" class="newsletter section-shell">
    <div class="newsletter-icon">✉</div>
    <div>
      <strong>Suscribite a nuestro newsletter</strong>
      <p>Recibí novedades, talleres, eventos y mucho más.</p>
    </div>
    <form id="newsletter-form">
      <input type="email" placeholder="Tu correo electrónico" required aria-label="Tu correo electrónico">
      <button type="submit">Suscribirme</button>
    </form>
    <div class="newsletter-note">Ideas, proyectos<br>y más en tu mail →</div>
  </section>
</main>

<footer class="site-footer">
  <div class="footer-main section-shell">
    <div class="footer-brand">
      <div class="brand footer-logo"><span class="brand-mark">◇</span><span>CASA<br>CUBO</span></div>
      <p>Arte · Diseño · Talleres · Comunidad</p>
    </div>
    <nav class="footer-nav">
      <a href="#inicio">Inicio</a><a href="#talleres">Talleres</a><a href="#eventos">Eventos</a><a href="#galeria">Galería</a><a href="#nosotros">Nosotros</a><a href="#contacto">Contacto</a>
    </nav>
    <div class="footer-location">⌖<br><strong>Benavidez 111</strong><br>Tigre, Buenos Aires</div>
    <div class="footer-store">La tienda online funciona a través de<br><a href="https://casacubo.empretienda.com.ar/" target="_blank" rel="noopener">Empretienda.com ↗</a></div>
  </div>
  <div class="footer-bottom section-shell">
    <span>Términos y condiciones &nbsp; | &nbsp; Privacidad</span>
    <span>Gracias por ser parte ♡</span>
  </div>
</footer>

{% if home.popup and home.popup.enabled %}
<div
  class="site-popup"
  data-site-popup
  data-popup-id="{{ home.popup.id or 'general' }}"
  data-delay="{{ home.popup.delay_seconds if home.popup.delay_seconds is defined else 12 }}"
  data-repeat-days="{{ home.popup.repeat_days if home.popup.repeat_days is defined else 7 }}"
  hidden
>
  <div class="site-popup-backdrop" data-popup-close></div>

  <div class="site-popup-dialog" role="dialog" aria-modal="true" aria-labelledby="site-popup-title">
    <button type="button" class="site-popup-close" data-popup-close aria-label="Cerrar popup">×</button>

    {% if home.popup.image %}
      <div class="site-popup-image">
        <img src="{{ home.popup.image }}" alt="{{ home.popup.title or 'Novedades de Casa Cubo' }}">
      </div>
    {% endif %}

    <div class="site-popup-copy">
      <span class="eyebrow">CASA CUBO</span>
      <h2 id="site-popup-title">{{ home.popup.title or 'Algo nuevo está pasando en Casa Cubo' }}</h2>

      {% if home.popup.text %}
        <p>{{ home.popup.text }}</p>
      {% endif %}

      {% if home.popup.button_link %}
        <a
          class="button button-dark site-popup-button"
          href="{{ home.popup.button_link }}"
          {% if home.popup.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          {{ home.popup.button_text or 'Ver más' }} <span>→</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}

<script src="/js/script.js"></script>
<script src="/js/eventos-auto.js" defer></script>
</body>
</html>
