<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta
    name="description"
    content="Casa Cubo — Arte, creatividad, talleres y comunidad."
  >

  <title>Casa Cubo — Arte, creatividad, talleres y comunidad</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="css/styles.css">
</head>

<body>

<header class="site-header">

  <!-- LOGO -->
  <a class="brand brand-logo" href="/" aria-label="Casa Cubo, inicio">
    <img
      src="https://ik.imagekit.io/fo8ajuwvyo/logocc.png"
      alt="Casa Cubo"
    >
  </a>

  <!-- MENÚ MÓVIL -->
  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-nav"
  >
    Menú
  </button>

  <!-- NAVEGACIÓN -->
  <nav id="main-nav" class="main-nav">
    <a class="active" href="#inicio">Inicio</a>
    <a href="#talleres">Experiencias</a>
    <a href="#galeria">Mirá</a>
    <a href="#nosotros">Comunidad</a>
    <a href="#contacto">Escribinos</a>
  </nav>

  <!-- ACCIONES -->
  <div class="header-actions">

    <a href="#" aria-label="Instagram">◎</a>
    <a href="#" aria-label="Facebook">●</a>

    <a
      class="store-link"
      href="https://casacubo.empretienda.com.ar/"
      target="_blank"
      rel="noopener"
    >
      Tienda online ↗
    </a>

  </div>

</header>


<main>

  <!-- HERO -->

  <section id="inicio" class="hero section-shell">

    <div class="hero-copy">

      <span class="eyebrow">CASA CUBO</span>

      <h1>
        Arte,<br>
        creatividad,<br>
        talleres y<br>
        comunidad.
      </h1>

      <p>
        Un lugar para descubrir, aprender, hacer, compartir y encontrar
        cosas que despierten curiosidad.
      </p>

      <a
        class="button button-pink"
        href="https://wa.me/5491141720467?text=Hola%2C%20vengo%20de%20la%20web%2C%20quiero%20conocer%20m%C3%A1s%20sobre%20Casa%20Cubo"
        target="_blank"
        rel="noopener"
      >
        Conocé más <span>→</span>
      </a>

    </div>


    <div class="hero-photo photo-frame">
      <img
        src="assets/img/hero.jpg"
        alt="Mesa de trabajo de Casa Cubo"
      >
    </div>


    <div class="hero-index">
      <strong>01</strong>
      <span>02</span>
      <span>03</span>
    </div>

    <div class="cube-watermark" aria-hidden="true">◇</div>

  </section>


  <!-- CATEGORÍAS -->

  <section class="categories section-shell">

    <!-- ARTE -->

    <a class="category cat-pink" href="#talleres">

      <span class="cat-icon">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 10C19 10 9 19 9 31c0 10 7 18 16 18h5c3 0 5-2 5-5 0-3-2-5-5-5h-2c-3 0-5-2-5-5s3-6 7-6h8c9 0 17-7 17-16C55 15 45 10 32 10Z"/>
          <circle cx="22" cy="27" r="2.5"/>
          <circle cx="30" cy="20" r="2.5"/>
          <circle cx="40" cy="20" r="2.5"/>
          <circle cx="47" cy="27" r="2.5"/>
        </svg>
      </span>

      <strong>Arte</strong>

      <small>
        Pintura, técnicas mixtas<br>
        y arte.
      </small>

      <b>→</b>

    </a>


    <!-- DISEÑO -->

    <a class="category cat-green" href="#talleres">

      <span class="cat-icon">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 8C22 18 14 29 14 41c0 8 7 15 18 15s18-7 18-15C50 29 42 18 32 8Z"/>
          <path d="M32 14C30 25 27 34 20 45"/>
          <path d="M31 25l-9-4"/>
          <path d="M28 33l-11-2"/>
          <path d="M25 40l-9 2"/>
        </svg>
      </span>

      <strong>Diseño</strong>

      <small>
        Objetos que inspiran<br>
        y decoran.
      </small>

      <b>→</b>

    </a>


    <!-- MECÁNICA DE BICIS -->

    <a class="category cat-yellow" href="#talleres">

      <span class="cat-icon">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="18" cy="44" r="11"/>
          <circle cx="47" cy="44" r="11"/>
          <path d="M18 44l10-22 10 22"/>
          <path d="M28 22h9"/>
          <path d="M37 22l10 22"/>
          <path d="M28 22l-5 0"/>
          <path d="M18 44h22"/>
          <path d="M35 30h9"/>
          <path d="M39 17h7"/>
          <path d="M43 14v6"/>
        </svg>
      </span>

      <strong>Mecánica de bicis</strong>

      <small>
        Talleres y mantenimiento.
      </small>

      <b>→</b>

    </a>


    <!-- CARPINTERÍA -->

    <a class="category cat-pink" href="#talleres">

      <span class="cat-icon">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M39 10l15 15-7 7-15-15z"/>
          <path d="M32 17L14 35"/>
          <path d="M14 35l-4 15 15-4 18-18"/>
          <path d="M18 42l6 6"/>
          <path d="M12 48l4 4"/>
        </svg>
      </span>

      <strong>Carpintería</strong>

      <small>
        Herramientas y proyectos.
      </small>

      <b>→</b>

    </a>


    <!-- CERÁMICA -->

    <a class="category cat-green" href="#talleres">

      <span class="cat-icon">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M22 14h20"/>
          <path d="M24 14c0 7 2 9 1 14-1 5-5 9-5 17 0 8 5 11 12 11s12-3 12-11c0-8-4-12-5-17-1-5 1-7 1-14"/>
          <path d="M22 22c6 3 14 3 20 0"/>
          <path d="M20 43c8 3 16 3 24 0"/>
        </svg>
      </span>

      <strong>Cerámica</strong>

      <small>
        Modelado y esmaltado.
      </small>

      <b>→</b>

    </a>


    <!-- REGALOS -->

    <a
      class="category cat-yellow"
      href="https://casacubo.empretienda.com.ar/"
      target="_blank"
      rel="noopener"
    >

      <span class="cat-icon">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M23 35h18l-2 20H25z"/>
          <path d="M21 35h22"/>
          <path d="M32 35V17"/>
          <path d="M32 25c-7 0-12-3-12-8 0-4 4-6 7-3 3 3 5 7 5 11Z"/>
          <path d="M32 25c7 0 12-3 12-8 0-4-4-6-7-3-3 3-5 7-5 11Z"/>
          <path d="M25 18c-2-5 0-9 4-10 3 4 2 8-1 11"/>
          <path d="M39 18c2-5 0-9-4-10-3 4-2 8 1 11"/>
        </svg>
      </span>

      <strong>Regalos</strong>

      <small>
        Objetos únicos y especiales.
      </small>

      <b>→</b>

    </a>

  </section>


  <!-- EXPERIENCIAS -->

  <section id="talleres" class="workshops section-shell">

    <div class="section-intro">

      <span class="eyebrow">EXPERIENCIAS</span>

      <h2>
        Aprendé,<br>
        creá, compartí
      </h2>

      <p>
        Descubrí nuestra propuesta de talleres, eventos y experiencias
        creativas. Desde técnicas tradicionales hasta propuestas
        contemporáneas, todo en un ambiente cálido y relajado.
      </p>

      <a
        class="button button-dark"
        href="/eventos/"
      >
        Ver todas las experiencias <span>→</span>
      </a>

    </div>


    <div class="workshop-grid">

      {% for evento in collections.eventos %}

        {% if evento.data.status == "publicado" %}

          <article class="workshop-card">

            <div class="card-image">
              <img
                src="{{ evento.data.image }}"
                alt="{{ evento.data.title }}"
              >
            </div>

            <span class="pill pill-pink">
              {{ evento.data.category }}
            </span>

            <h3>{{ evento.data.title }}</h3>

            <p class="date">
              ▣ {{ evento.data.sort_date | date_short }}
              ·
              {{ evento.data.time }}
            </p>

            <p>{{ evento.data.excerpt }}</p>

            <a href="{{ evento.url }}">
              Ver más →
            </a>

          </article>

        {% endif %}

      {% endfor %}


      {% if collections.eventos | length == 0 %}

        <article class="workshop-card workshop-empty">
          <h3>Próximamente</h3>
          <p>Estamos preparando nuevas experiencias en Casa Cubo.</p>
        </article>

      {% endif %}

    </div>


    <button
      class="slider-arrow"
      type="button"
      aria-label="Ver todas las experiencias"
      onclick="window.location.href='/eventos/'"
    >
      →
    </button>

  </section>


  <!-- COMUNIDAD -->

  <section id="nosotros" class="about section-shell">

    <div class="about-photo photo-frame">
      <img
        src="assets/img/about.jpg"
        alt="Espacio creativo de Casa Cubo"
      >
    </div>

   <div class="about-copy">

  <span class="eyebrow">SOBRE CASA CUBO</span>

  <h2>
    Un lugar para crear nuevos mundos
  </h2>

  <div class="about-text">

    <p>
      Hay muchas formas de hacerlo: aprender un oficio, pintar, jugar,
      reparar, inventar, compartir lo que sabemos, descubrir algo nuevo
      o simplemente encontrarnos.
    </p>

    <p>
      <em>CUBO es ese lugar.</em>
    </p>

    <p>
      Un universo de arte, oficios, objetos, talleres, encuentros y
      experiencias que crece a partir de una comunidad de personas
      curiosas y creativas.
    </p>

    <p>
      Un universo que ya tiene una historia y sigue tomando nuevas formas.
    </p>

    <p>
      <em>Crear Nuevos Mundos es parte de ese mundo. CUBO también.</em>
    </p>

  </div>

  <a
    class="button button-outline"
    href="/crear-nuevos-mundos/"
  >
    Conocé Crear Nuevos Mundos <span>→</span>
  </a>

</div>

  </section>


  <!-- MIRÁ -->

  <section id="galeria" class="look-section section-shell">

  <div class="look-header">
    <span class="eyebrow">MIRÁ</span>

    <h2>
      Cosas que pasan<br>
      en Casa Cubo
    </h2>

    <p>
      Talleres, objetos, encuentros, procesos y algunas cosas
      difíciles de clasificar.
    </p>

    <a
      class="button button-outline"
      href="#"
      target="_blank"
      rel="noopener"
    >
      Ver Instagram&nbsp; ◎
    </a>
  </div>


  <div class="look-grid">

    <figure class="look-item look-a">
      <img
        src="assets/img/insta-pinceles.jpg"
        alt="Materiales y pinceles en Casa Cubo"
      >
    </figure>

    <figure class="look-item look-b">
      <img
        src="assets/img/insta-taller.jpg"
        alt="Taller en Casa Cubo"
      >
    </figure>

    <figure class="look-item look-c">
      <img
        src="assets/img/insta-taza.jpg"
        alt="Objeto realizado en Casa Cubo"
      >
    </figure>

    <figure class="look-item look-d">
      <img
        src="assets/img/insta-galeria.jpg"
        alt="Galería de Casa Cubo"
      >
    </figure>

    <figure class="look-item look-e">
      <img
        src="assets/img/insta-plantas.jpg"
        alt="Plantas y espacio de Casa Cubo"
      >
    </figure>

    <figure class="look-item look-f">
      <img
        src="assets/img/workshop-ceramica.jpg"
        alt="Taller de cerámica"
      >
    </figure>

    <figure class="look-item look-g">
      <img
        src="assets/img/workshop-pintura.jpg"
        alt="Taller de pintura"
      >
    </figure>

    <figure class="look-item look-h">
      <img
        src="assets/img/workshop-bicis.jpg"
        alt="Taller de bicicletas"
      >
    </figure>

    <figure class="look-item look-i">
      <img
        src="assets/img/about.jpg"
        alt="Casa Cubo"
      >
    </figure>

    <figure class="look-item look-j">
      <img
        src="assets/img/hero.jpg"
        alt="Espacio Casa Cubo"
      >
    </figure>

  </div>

</section>

  <!-- ESCRIBINOS -->

  <section id="contacto" class="newsletter section-shell">

    <div class="newsletter-icon">✉</div>

    <div>
      <strong>Suscribite a nuestro newsletter</strong>
      <p>Recibí novedades, talleres, eventos y mucho más.</p>
    </div>

    <form id="newsletter-form">

      <input
        type="email"
        placeholder="Tu correo electrónico"
        required
        aria-label="Tu correo electrónico"
      >

      <button type="submit">
        Suscribirme
      </button>

    </form>

    <div class="newsletter-note">
      Ideas, proyectos<br>
      y más en tu mail →
    </div>

  </section>

</main>


<!-- FOOTER -->

<footer class="site-footer">

  <div class="footer-main section-shell">

    <div class="footer-brand">

      <div class="brand footer-logo">
        <img
  src="https://ik.imagekit.io/fo8ajuwvyo/logocc-blanco.png"
  alt="Casa Cubo"
>
      </div>

      <p>
        Arte · Creatividad · Talleres · Comunidad
      </p>

    </div>


    <nav class="footer-nav">

      <a href="#inicio">Inicio</a>

      <a href="#talleres">Experiencias</a>

      <a href="#galeria">Mirá</a>

      <a href="#nosotros">Comunidad</a>

      <a href="#contacto">Escribinos</a>

    </nav>


    <div class="footer-location">
      ⌖<br>
      <strong>Benavidez 111</strong><br>
      Monte Grande, Buenos Aires
    </div>


    <div class="footer-store">

      Tienda online<br>

      <a
        href="https://casacubo.empretienda.com.ar/"
        target="_blank"
        rel="noopener"
      >
        Ir a la tienda ↗
      </a>

    </div>

  </div>


  <div class="footer-bottom section-shell">

    <span>
      Términos y condiciones
      &nbsp; | &nbsp;
      Privacidad
    </span>

    <span>
      Gracias por ser parte ♡
    </span>

  </div>

</footer>


