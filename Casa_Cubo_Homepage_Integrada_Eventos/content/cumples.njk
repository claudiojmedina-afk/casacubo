---
permalink: /cumples/
---

<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Cumples creativos | Casa Cubo</title>

  <meta
    name="description"
    content="Cumpleaños creativos en Casa Cubo. Elegí entre distintas propuestas de arte, juego y creación."
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

<header class="site-header">

  <a class="brand brand-logo" href="/" aria-label="Casa Cubo, inicio">
    <img
      src="https://ik.imagekit.io/fo8ajuwvyo/logocc.png"
      alt="Casa Cubo"
    >
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-nav"
  >
    Menú
  </button>

  <nav id="main-nav" class="main-nav">
    <a href="/">Inicio</a>
    <a href="/crear-nuevos-mundos/">Clases</a>
    <a href="/eventos/">Eventos</a>
    <a class="active" href="/cumples/">Cumples</a>
  </nav>

  <div class="header-actions">
    <a
      class="store-link"
      href="https://crearnuevosmundos.empretienda.com.ar/"
      target="_blank"
      rel="noopener"
    >
      Tienda online ↗
    </a>
  </div>

</header>


<main class="cumples-page">

  <section class="cumples-hero section-shell">

    <div class="cumples-hero-copy">

      <span class="eyebrow">CUMPLES EN CASA CUBO</span>

      <h1>
        Cumples<br>
        creativos
      </h1>

      <p class="cumples-lead">
        Festejos diferentes para imaginar, crear y compartir.
      </p>

      <p>
        Elegí una propuesta creativa y nosotros nos ocupamos de convertirla
        en una experiencia para festejar, jugar y llevarse algo hecho con
        sus propias manos.
      </p>

    </div>

    <div class="cumples-hero-art">

      <div class="cumples-shape cumples-shape-one"></div>
      <div class="cumples-shape cumples-shape-two"></div>

      <div class="cumples-doodle">
        ✦<br>
        CREAR<br>
        JUGAR<br>
        FESTEJAR
      </div>

    </div>

  </section>


  <section class="cumples-options section-shell">

    <div class="cumples-section-header">

      <div>
        <span class="eyebrow">ELEGÍ UNA OPCIÓN</span>
        <h2>Nuestras propuestas</h2>
      </div>

      <p>
        Todas las propuestas pueden adaptarse según la edad y el grupo.
      </p>

    </div>


    <div class="cumples-grid">

      {% for cumple in collections.cumples %}

        {% if cumple.data.status == "publicado" %}

          <article class="cumple-card">

            <a
              class="cumple-card-image"
              href="{{ cumple.url }}"
            >
              <img
                src="{{ cumple.data.cover_image }}"
                alt="{{ cumple.data.title }}"
              >
            </a>

            <div class="cumple-card-content">

              <h3>
                <a href="{{ cumple.url }}">
                  {{ cumple.data.title }}
                </a>
              </h3>

              <p>
                {{ cumple.data.excerpt }}
              </p>

              <div class="cumple-card-meta">

                {% if cumple.data.age %}
                  <span>
                    ◯ {{ cumple.data.age }}
                  </span>
                {% endif %}

                {% if cumple.data.duration %}
                  <span>
                    ◷ {{ cumple.data.duration }}
                  </span>
                {% endif %}

              </div>

              <a
                class="cumple-card-button"
                href="{{ cumple.url }}"
              >
                Ver opción →
              </a>

            </div>

          </article>

        {% endif %}

      {% endfor %}

    </div>

  </section>

</main>


<footer class="site-footer">

  <div class="footer-main section-shell">

    <div class="footer-brand">

      <div class="brand footer-logo">
        <img
          src="https://ik.imagekit.io/fo8ajuwvyo/logocc-blanco.png"
          alt="Casa Cubo"
        >
      </div>

      <p>
        Arte · Creatividad · Talleres · Comunidad
      </p>

    </div>

  </div>

</footer>

<script src="/js/script.js"></script>

</body>
</html>
