<!doctype html>
<html lang="es">

<head>

  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>{{ title }} · Crear Nuevos Mundos</title>

  <link rel="stylesheet" href="/css/evento.css">

</head>


<body>

<header class="site-header">

  <a
    class="brand"
    href="/"
  >
    Casa Cubo
  </a>

  <nav>

    <a href="/">
      Inicio
    </a>

    <a href="/crear-nuevos-mundos/">
      Crear Nuevos Mundos
    </a>

  </nav>

</header>


<main>

<section class="event-hero">

  <div class="hero-image">

    <img
      src="{{ image }}"
      alt="{{ title }}"
    >

  </div>


  <div class="hero-copy">

    <span class="pill">
      {{ category }}
    </span>

    <h1>
      {{ title }}
    </h1>

    <p class="lead">
      {{ excerpt }}
    </p>


    <div class="hero-meta">

      {% if audience %}

        <div>

          <small>DESTINADO A</small>

          <strong>
            {{ audience }}
          </strong>

        </div>

      {% endif %}


      {% if schedule %}

        <div>

          <small>DÍAS Y HORARIOS</small>

          <strong>
            {{ schedule }}
          </strong>

        </div>

      {% endif %}


      {% if price %}

        <div>

          <small>VALOR</small>

          <strong>
            {{ price | money_ar }}
          </strong>

        </div>

      {% endif %}

    </div>


    <div class="hero-actions">

      {% if form_url %}

        <a
          class="cta"
          href="{{ form_url }}"
          target="_blank"
          rel="noopener"
        >
          Inscribirme <span>→</span>
        </a>

      {% endif %}


      <a
        class="cta"
        href="https://wa.me/5491141720467?text=Hola%2C%20vengo%20de%20la%20web%20y%20quiero%20consultar%20por%20el%20taller%20{{ title }}"
        target="_blank"
        rel="noopener"
      >
        Consultar por taller <span>→</span>
      </a>

    </div>

  </div>

</section>


<section class="content-grid">

  <article class="article-copy">

    {{ content | safe }}

  </article>


  <aside class="info-card">

    {% if include %}

      <p class="eyebrow">
        QUÉ INCLUYE
      </p>

      <ul>

        {% for item in include %}

          <li>
            {{ item }}
          </li>

        {% endfor %}

      </ul>

    {% endif %}


    {% if bring %}

      <p class="eyebrow second">
        QUÉ TRAER
      </p>

      <ul>

        {% for item in bring %}

          <li>
            {{ item }}
          </li>

        {% endfor %}

      </ul>

    {% endif %}

  </aside>

</section>


{% if instructors and instructors.length %}

<section class="instructor-section">

  <div>

    <p class="eyebrow">
      QUIÉNES GUÍAN EL TALLER
    </p>


    {% for instructor in instructors %}

      <div class="instructor-item">

        {% if instructor.image %}

          <div class="instructor-photo">

            <img
              src="{{ instructor.image }}"
              alt="{{ instructor.name }}"
            >

          </div>

        {% endif %}


        <div>

          <h2>
            {{ instructor.name }}
          </h2>

          {% if instructor.role %}

            <p>
              {{ instructor.role }}
            </p>

          {% endif %}

        </div>

      </div>

    {% endfor %}

  </div>

</section>

{% endif %}

</main>

<a
  class="whatsapp-float"
  href="https://wa.me/5491141720467?text=Hola%2C%20vengo%20de%20la%20web%20de%20Casa%20Cubo"
  target="_blank"
  rel="noopener"
  aria-label="Consultar por WhatsApp"
>
  <svg
    viewBox="0 0 32 32"
    aria-hidden="true"
  >
    <path
      d="M19.11 17.2c-.28-.14-1.64-.81-1.89-.9-.25-.09-.44-.14-.62.14-.18.28-.71.9-.87 1.08-.16.18-.32.21-.6.07-.28-.14-1.17-.43-2.23-1.38-.82-.73-1.38-1.64-1.54-1.92-.16-.28-.02-.43.12-.57.13-.13.28-.32.41-.48.14-.16.18-.28.28-.46.09-.18.05-.34-.02-.48-.07-.14-.62-1.5-.85-2.05-.22-.54-.45-.47-.62-.48h-.53c-.18 0-.48.07-.73.34-.25.28-.96.94-.96 2.28s.98 2.64 1.12 2.82c.14.18 1.93 2.95 4.68 4.13.65.28 1.16.45 1.56.58.66.21 1.25.18 1.72.11.52-.08 1.64-.67 1.87-1.32.23-.65.23-1.2.16-1.32-.07-.12-.25-.19-.53-.33z"
    />
    <path
      d="M16.03 3C8.84 3 3 8.74 3 15.82c0 2.26.6 4.47 1.74 6.41L3 29l6.96-1.8a13.15 13.15 0 0 0 6.07 1.53h.01C23.22 28.73 29 22.99 29 15.9 29 8.82 23.22 3 16.03 3zm0 23.55h-.01a10.9 10.9 0 0 1-5.56-1.52l-.4-.24-4.13 1.07 1.1-4.01-.26-.41a10.66 10.66 0 0 1-1.64-5.62c0-5.9 4.9-10.7 10.91-10.7 6 0 10.88 4.81 10.88 10.73 0 5.9-4.89 10.7-10.89 10.7z"
    />
  </svg>
</a>

</body>
</html>
