<!doctype html>
<html lang="es">


<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>{{ title }} · Crear Nuevos Mundos</title>

  <link rel="canonical" href="https://casacubo.com.ar{{ page.url }}">

  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/evento.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/whatsapp.css">
</head>



<body>


<header class="site-header">

  <a class="brand brand-logo" href="/" aria-label="Casa Cubo, inicio">
    <img
      src="/assets/img/logo-cubo.png"
      alt="Casa Cubo"
      width="110"
      height="72"
      style="display:block; width:100%; height:100%; object-fit:contain;"
    >
  </a>

  <nav>

    <a href="/">Inicio</a>

    <a href="/crear-nuevos-mundos/">
      Crear Nuevos Mundos
    </a>

  </nav>

</header>



<main>

  <!-- HERO -->

  <section class="event-hero">

    {% if image %}

      <div class="hero-image">

        <img
          src="{{ image }}"
          alt="{{ title }}"
        >

      </div>

    {% endif %}


    <div class="hero-copy">

      {% if categories and categories.length %}

        <div class="workshop-categories">

          {% for item in categories %}

            <span class="pill">
              {{ item }}
            </span>

          {% endfor %}

        </div>

      {% elseif category %}

        <span class="pill">
          {{ category }}
        </span>

      {% endif %}


      <h1>
        {{ title }}
      </h1>


      {% if excerpt %}

        <p class="lead">
          {{ excerpt }}
        </p>

      {% endif %}


      <div class="hero-meta">

        {% if audience %}

          <div>

            <small>
              DESTINADO A
            </small>

            <strong>
              {{ audience }}
            </strong>

          </div>

        {% endif %}


        {% if schedule %}

          <div>

            <small>
              DÍAS Y HORARIOS
            </small>

            <div class="schedule-list">

              {% if schedule[0] and schedule[0].day %}

                {% for option in schedule %}

                  <div class="schedule-option">

                    <strong>
                      {{ option.day }}
                    </strong>

                    {% if option.time %}

                      <span>
                        {{ option.time }}
                      </span>

                    {% endif %}

                  </div>

                {% endfor %}

              {% else %}

                <strong>
                  {{ schedule }}
                </strong>

              {% endif %}

            </div>

          </div>

        {% endif %}


        {% if price %}

          <div>

            <small>
              VALOR
            </small>

            <strong>
              {{ price | money_ar }}
            </strong>

          </div>

        {% endif %}

      </div>


      <div class="hero-actions">

        {% if form_url %}

          <a
            class="cta"
            href="#inscripcion"
          >
            Inscribirme <span>→</span>
          </a>

        {% endif %}


        <a
          class="cta"
          href="https://wa.me/5491141720467?text=Hola%2C%20vengo%20de%20la%20web%20y%20quiero%20consultar%20por%20el%20taller%20{{ title }}"
          target="_blank"
          rel="noopener"
        >
          Consultar por taller <span>→</span>
        </a>

      </div>

    </div>

  </section>



  <!-- CONTENIDO -->

  {% if content or include or bring %}

    <section class="content-grid">

      {% if content %}

        <article class="article-copy">
          {{ content | safe }}
        </article>

      {% endif %}


      {% if include or bring %}

        <aside class="info-card">

          {% if include and include.length %}

            <p class="eyebrow">
              QUÉ INCLUYE
            </p>

            <ul>

              {% for item in include %}

                <li>
                  {{ item }}
                </li>

              {% endfor %}

            </ul>

          {% endif %}


          {% if bring and bring.length %}

            <p class="eyebrow second">
              QUÉ TRAER
            </p>

            <ul>

              {% for item in bring %}

                <li>
                  {{ item }}
                </li>

              {% endfor %}

            </ul>

          {% endif %}

        </aside>

      {% endif %}

    </section>

  {% endif %}



  <!-- INSTRUCTORES -->

  {% if instructors and instructors.length %}

    <section class="instructor-section">

      <div>

        <p class="eyebrow">
          QUIÉNES GUÍAN EL TALLER
        </p>


        {% for instructor in instructors %}

          <div class="instructor-item">

            {% if instructor.image %}

              <div class="instructor-photo">

                <img
                  src="{{ instructor.image }}"
                  alt="{{ instructor.name }}"
                >

              </div>

            {% endif %}


            <div>

              {% if instructor.name %}

                <h2>
                  {{ instructor.name }}
                </h2>

              {% endif %}


              {% if instructor.role %}

                <p>
                  {{ instructor.role }}
                </p>

              {% endif %}

            </div>

          </div>

        {% endfor %}

      </div>

    </section>

  {% endif %}



  <!-- INSCRIPCIÓN -->

  {% if form_url %}

    <section
      id="inscripcion"
      class="registration"
    >

      <div class="registration-head">

        <div>

          <p class="eyebrow">
            INSCRIPCIÓN
          </p>

          <h2>
            Sumate al taller
          </h2>

        </div>


        <p>
          Completá el formulario para reservar tu lugar.
        </p>

      </div>


      <div class="form-frame">

        <iframe
          src="{{ form_url }}"
          title="Formulario de inscripción: {{ title }}"
          loading="lazy"
        >
          Cargando formulario…
        </iframe>

      </div>


      <p>
        <a
          href="{{ form_url }}"
          target="_blank"
          rel="noopener"
        >
          Abrir formulario en otra pestaña ↗
        </a>
      </p>

    </section>

  {% endif %}

</main>

{% include "footer.njk" %}

<!-- BOTÓN GLOBAL DE WHATSAPP -->
{% include "whatsapp.njk" %}

</body>
</html>
