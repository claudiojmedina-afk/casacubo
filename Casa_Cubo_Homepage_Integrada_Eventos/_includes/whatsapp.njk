
{% set whatsapp_message = "Hola, vengo de la web de Casa Cubo y quisiera hacer una consulta." %}

{% if page.url == "/crear-nuevos-mundos/" %}

  {% set whatsapp_message = "Hola, quisiera recibir información sobre las clases de Crear Nuevos Mundos." %}

{% elseif page.url == "/eventos/" %}

  {% set whatsapp_message = "Hola, quisiera recibir información sobre las próximas experiencias de Casa Cubo." %}

{% elseif page.url == "/cumples/" %}

  {% set whatsapp_message = "Hola, quisiera recibir información sobre los cumples creativos." %}

{% elseif page.url and title and "/eventos/" in page.url %}

  {% set whatsapp_message = "Hola, quisiera consultar por la experiencia " + title + "." %}

{% elseif page.url and title and "/cumples/" in page.url %}

  {% set whatsapp_message = "Hola, quisiera consultar por el cumple creativo " + title + "." %}

{% elseif page.url and title and "/talleres-regulares/" in page.url %}

  {% set whatsapp_message = "Hola, quisiera recibir información sobre el taller " + title + "." %}

{% endif %}


<a
