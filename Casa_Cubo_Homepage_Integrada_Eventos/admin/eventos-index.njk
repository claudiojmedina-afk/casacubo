---
title: Eventos | Casa Cubo
permalink: /eventos/
---
{% set grupos = collections.eventos | splitEventsByDate %}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Eventos | Casa Cubo</title>
  <meta
    name="description"
    content="Talleres, experiencias y eventos de Casa Cubo."
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/evento.css">
</head>

<body class="listing-page">

  <header class="site-header">

    <a class="brand brand-logo" href="/" aria-label="Casa Cubo, inicio">
      <img
        src="https://ik.imagekit.io/fo8ajuwvyo/logocc.png"
        alt="Casa Cubo"
      >
    </a>

    <nav>
      <a href="/">Inicio</a>
      <a class="active" href="/eventos/">Experiencias</a>
      <a href="/crear-nuevos-mundos/">Crear Nuevos Mundos</a>
      <a
        href="https://crearnuevosmundos.empretienda.com.ar/"
        target="_blank"
        rel="noopener"
      >
        Tienda online ↗
      </a>
    </nav>

  </header>


  <main class="listing-wrap">

    <header class="listing-header">
      <p class="eyebrow">CASA CUBO / AGENDA</p>

      <h1>Próximas experiencias.</h1>

      <p class="listing-intro">
        Talleres, encuentros y experiencias para crear, aprender y compartir.
      </p>
    </header>


    <section class="events-section" aria-labelledby="proximas-experiencias">

      <div class="events-section-head">
        <div>
          <p class="eyebrow">LO QUE VIENE</p>
          <h2 id="proximas-experiencias">Próximas experiencias</h2>
        </div>

        <p>
          Ordenadas desde la fecha más cercana.
        </p>
      </div>


      {% if grupos.upcoming.length %}

        <div class="event-grid">

          {% for evento in grupos.upcoming %}

            <a class="event-card" href="{{ evento.url }}">

              <div class="event-card-image">
                <img
                  src="{{ evento.data.image }}"
                  alt="{{ evento.data.title }}"
                >
              </div>

              <div class="event-card-copy">

                <span class="pill">
                  {{ evento.data.category }}
                </span>

                <h2>{{ evento.data.title }}</h2>

                <p>{{ evento.data.excerpt }}</p>

                <div class="event-card-meta">
                  {{ evento.data.sort_date | date_es }}
                  {% if evento.data.time %}
                    · {{ evento.data.time }}
                  {% endif %}
                </div>

              </div>

            </a>

          {% endfor %}

        </div>

      {% else %}

        <div class="events-empty">
          <p>No hay próximas experiencias publicadas por ahora.</p>
        </div>

      {% endif %}

    </section>


    {% if grupos.past.length %}

      <section
        class="events-section events-section--past"
        aria-labelledby="experiencias-anteriores"
      >

        <div class="events-section-head">
          <div>
            <p class="eyebrow">ARCHIVO</p>
            <h2 id="experiencias-anteriores">Experiencias que ya pasaron</h2>
          </div>

          <p>
            Encuentros anteriores de Casa Cubo.
          </p>
        </div>


        <div class="event-grid event-grid--past">

          {% for evento in grupos.past %}

            <a
              class="event-card event-card--past"
              href="{{ evento.url }}"
            >

              <div class="event-card-image">

                <img
                  src="{{ evento.data.image }}"
                  alt="{{ evento.data.title }}"
                >

                <span class="event-finished">
                  Finalizado
                </span>

              </div>

              <div class="event-card-copy">

                <span class="pill">
                  {{ evento.data.category }}
                </span>

                <h2>{{ evento.data.title }}</h2>

                <p>{{ evento.data.excerpt }}</p>

                <div class="event-card-meta">
                  {{ evento.data.sort_date | date_es }}
                  {% if evento.data.time %}
                    · {{ evento.data.time }}
                  {% endif %}
                </div>

                <div class="event-card-state">
                  Evento finalizado
                </div>

              </div>

            </a>

          {% endfor %}

        </div>

      </section>

    {% endif %}

  </main>


  <a
    class="whatsapp-float"
    href="https://wa.me/5491141720467?text=Hola%2C%20vengo%20de%20la%20web%20de%20Casa%20Cubo"
    target="_blank"
    rel="noopener"
    aria-label="Consultar por WhatsApp"
  >
